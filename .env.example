# Application environment: local | staging | production
APP_ENV=local

# Database — local XAMPP defaults if unset.
# On Sevalla, connect the MySQL database (Networking → Add internal connection)
# and tick “Add environment variables”. Rename keys to match these if needed.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=PartnershipRegistry
DB_USER=root
DB_PASS=

# Sevalla also accepts: DATABASE_HOST, DATABASE_NAME, DATABASE_USER,
# DATABASE_PASSWORD, DATABASE_PORT (auto-created by an internal connection).

# Application URL (used in expiry alert emails)
# APP_URL=http://localhost/IS406_PartnershipRegistry

# Mail (local dev logs to storage/logs/mail.log when send fails)
# MAIL_DRIVER=log
# MAIL_FROM_ADDRESS=pdmis@dwu.ac.pg
# MAIL_FROM_NAME=DWU Partnership Registry
